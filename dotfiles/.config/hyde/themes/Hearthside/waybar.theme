$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* To enable blur please make sure alpha is greater than 0 */
@define-color bar-bg rgba(26, 18, 16, 0.55);

@define-color main-bg #2a1c16;
@define-color main-fg #f2e2c4;

@define-color wb-act-bg #e8743b;
@define-color wb-act-fg #1a1210;

@define-color wb-hvr-bg #f5a742;
@define-color wb-hvr-fg #1a1210;
